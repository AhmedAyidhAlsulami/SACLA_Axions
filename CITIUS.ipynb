base_path = "./"

run_start, run_end = 1617472, 1617472  # inclusive range


for i, run in enumerate(range(run_start, run_end + 1), start=1):
    fileName = f"{base_path}/citius_BL3_r{run}.npy"
    arr = np.load(fileName)
    globals()[f"arr{i}"] = arr  # create arr1, arr2, ... arr11
    print(f"Loaded arr{i} from {fileName}")

# Sum all arrays together
arr_sum = sum(globals()[f"arr{i}"] for i in range(1, run_end - run_start + 2))

print("All arrays summed. Result shape:", arr_sum.shape)


import matplotlib.pyplot as plt
from matplotlib.patches import Rectangle

# ROI coordinates (x1, y1, x2, y2)
x1, y1, x2, y2 = 160, 340, 230, 400
w, h = x2 - x1, y2 - y1

plt.figure(figsize=(8,6))
im = plt.imshow(arr_sum, cmap='viridis', origin='lower', aspect='auto', vmin=0, vmax=0.1e-3)
plt.colorbar(label='Intensity')

ax = plt.gca()
rect = Rectangle((x1, y1), w, h,
                 linewidth=2, edgecolor='red', facecolor='none')
ax.add_patch(rect)

plt.title('Citius BL3 Run 1617472')
plt.xlabel('X pixel index')
plt.ylabel('Y pixel index')

plt.text(x1 + 2, y2 + 4, "ROI", color='red', fontsize=12, weight='bold')

plt.tight_layout()
plt.show()




